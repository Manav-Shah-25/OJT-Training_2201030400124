<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airline Demo Website</title>
    <style>
        * {box-sizing: border-box}
        body {font-family: Verdana, sans-serif; margin:0; background-color: #f4f4f4;}

        
        .header {
            background-color: rgb(7, 41, 82);
            padding: 1px 2px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            height: 80px;
            box-sizing: border-box;
            overflow: hidden;
        }

        .content {
            display: flex;         
            flex-direction: row;   
            align-items: center;   
            gap: 10px;             
        }

        .content button {
            background: transparent;
            color: white;
            border: 1px solid white;
            padding: 8px 15px;
            cursor: pointer;
        }

        .content button:hover {
            background-color: #B79257;
            transition: background-color 0.3s, transform 0.2s;
        }

        .content button:active {
           background-color: rgb(7, 41, 82);
        }

        .logo-area img {
            height: 70px; 
            width: auto;
            display: block;
        }

        .User-Profile {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .User-Profile button {
            height: 45px;  
            width: 45px;   
            border-radius: 50%; 
            padding: 2px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            cursor: pointer;
        }

        .User-Profile button img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
        }

        .slideshow-container {
            height: 600px;
            position: relative;
            margin: 20px auto;
            overflow: hidden;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
        }

        .slide {
            display: none;
        }

        .slide img {
            width: 100%;
            height: 600px;
            object-fit: cover;
            vertical-align: middle;
        }

        .prev, .next {
            cursor: pointer;
            position: absolute;
            top: 50%;
            width: auto;
            padding: 16px;
            margin-top: -22px;
            color: white;
            font-weight: bold;
            font-size: 18px;
            transition: 0.6s ease;
            border-radius: 0 3px 3px 0;
            user-select: none;
            background-color: rgba(0,0,0,0.3);
        }

        .next {
            right: 0;
            border-radius: 3px 0 0 3px;
        }

        .prev:hover, .next:hover {
            background-color: rgba(0,0,0,0.8);
        }

        .text {
            color: #ffffff;
            font-size: 18px;
            padding: 15px;
            position: absolute;
            bottom: 20px;
            width: 100%;
            text-align: center;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .dot {
            cursor: pointer;
            height: 15px;
            width: 15px;
            margin: 0 2px;
            background-color: #bbb;
            border-radius: 50%;
            display: inline-block;
            transition: background-color 0.6s ease;
        }

        .active, .dot:hover {
            background-color: #717171;
        }

        .fade {
            animation-name: fade;
            animation-duration: 1.5s;
        }

        @keyframes fade {
            from {opacity: .4} 
            to {opacity: 1}
        }

        h3 {
            background-color: rgb(7, 41, 82);
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 30px;
        }

        table {
            border-collapse: collapse;
            width: 80%;
            margin: 20px auto;
        }

        table, td, th {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: rgb(7, 41, 82);
            color: white;
        }

        tr:nth-child(even) {background-color: #f2f2f2;}
        :root 
        {
        --sq-blue: #072952;
        --sq-gold: #bd954f; 
        --light-bg: #f4f7f9;
        }

    .destination-container {
        width: 90%;
        margin: 40px auto;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    .destination-table {
        width: 100%;
        border-collapse: collapse;
    }

    .destination-table th {
        background-color: var(--sq-blue);
        color: white;
        padding: 20px;
        text-align: left;
        font-size: 14px;
        text-transform: uppercase;
        border-bottom: 3px solid var(--sq-gold);
    }

    .destination-table td {
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
        font-size: 15px;
    }

    .continent-cell {
        background-color: var(--light-bg);
        font-weight: 700;
        color: var(--sq-blue);
        text-align: center;
        border-right: 1px solid #ddd;
        width: 150px;
    }

    .airport-pill {
        background: #f0f0f0;
        padding: 4px 8px;
        border-radius: 4px;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
        color: #555;
    }

    .status-tag {
        color: #2e7d32;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .destination-table tr:hover td {
        background-color: #fafafa;
    }

    /* Sidebar Container */
    .sidebar {
        height: 100%;
        width: 0; /* Starts at zero width */
        position: fixed;
        z-index: 2000; /* Above everything else */
        top: 0;
        right: 0; /* Slides from the right */
        background-color: #B79257; /* Matches your header */
        overflow-x: hidden;
        transition: 0.4s; /* This creates the sliding animation */
        padding-top: 60px;
        box-shadow: -5px 0 15px rgba(0,0,0,0.3);
    }

    /* Links inside the sidebar */
    .sidebar-links a {
        padding: 15px 30px;
        text-decoration: none;
        font-size: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.3s;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    /* This adds the '>' symbol automatically */
    .sidebar-links a::after {
        content: '›'; /* This is a special 'angle' symbol, looks better than '>' */
        font-size: 24px;
        color: white; /* Slightly faded arrow */
        transition: 0.3s;
    }

    /* Make the arrow brighten and move on hover */
    .sidebar-links a:hover::after {
        color: white;
        transform: translateX(5px); /* Arrow nudges to the right */
    }

    /* Hover effect for links */
    .sidebar-links a:hover {
        background-color: rgb(7, 41, 82);
        padding-left: 40px; /* Slight nudge on hover */
    }

    /* The X button */
    .sidebar .closebtn {
        position: absolute;
        top: 10px;
        left: 25px;
        font-size: 36px;
        color: white;
        text-decoration: none;
    }

    .user-sidebar {
