<script>
  $('#hamburger').on('click', function () {
    $('#navLinks').toggleClass('open');
  });

  $('#navLinks a').on('click', function () {
    $('#navLinks').removeClass('open');
  });

  var sampleRoutes = [
    {
      mode: '🚇 Metro + 🚶 Walk',
      time: '22 min',
      cost: '₹35',
      detail: 'Take Blue Line (6 stops) → Walk 400m to destination. Platform 2, departs in 4 min.'
    },
    {
      mode: '🚌 Bus',
      time: '38 min',
      cost: '₹15',
      detail: 'Board Route 312 at Station Road → 8 stops. Moderate crowd. Bus arriving in 7 min.'
    },
    {
      mode: '🚕 Cab',
      time: '19 min',
      cost: '₹165',
      detail: 'Cab available in 3 min. Via Highway flyover. Surge pricing: 1.2x currently active.'
    },
    {
      mode: '🚇 Metro + 🚌 Bus',
      time: '30 min',
      cost: '₹50',
      detail: 'Metro to junction (5 stops) + Bus No. 80 for last 3 km. Best option under ₹60.'
    }
  ];

  $('#searchBtn').on('click', function () {
    var from = $('#fromInput').val().trim();
    var to   = $('#toInput').val().trim();

    if (from === '' || to === '') {
      $('#result-box')
        .show()
        .css('border-left-color', '#e63946')
        .html('⚠️ Please enter both a starting location and a destination.');
      return;
    }

    $(this).text('Searching...').prop('disabled', true);
    var btn = $(this);

    setTimeout(function () {
      var route = sampleRoutes[Math.floor(Math.random() * sampleRoutes.length)];

      $('#result-box')
        .css('border-left-color', '#2a9d8f')
        .html(
          '<strong>✅ Best route found for: ' + from + ' → ' + to + '</strong><br><br>' +
          '🚦 Mode: ' + route.mode + '<br>' +
          '⏱ Time: <strong>' + route.time + '</strong>&nbsp;&nbsp;|&nbsp;&nbsp;' +
          '💸 Cost: <strong>' + route.cost + '</strong><br><br>' +
          route.detail
        )
        .hide()
        .slideDown(300);

      btn.text('Search Best Route').prop('disabled', false);
    }, 1200);
  });

  $('#toInput').on('keypress', function (e) {
    if (e.which === 13) {
      $('#searchBtn').trigger('click');
    }
  });

  $('.city-card').on('click', function () {
    var city = $(this).data('city');
    $('#fromInput').val(city + ' — ');
    $('html, body').animate({ scrollTop: 0 }, 500);
    $('#fromInput').focus();
  });

  $('.faq-question').on('click', function () {
    var item = $(this).closest('.faq-item');
    var isOpen = item.hasClass('open');

    $('.faq-item').removeClass('open');
    $('.faq-answer').slideUp(250);

    if (!isOpen) {
      item.addClass('open');
      item.find('.faq-answer').slideDown(250);
    }
  });
</script>
